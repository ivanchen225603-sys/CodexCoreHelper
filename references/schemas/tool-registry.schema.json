{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-lifecycle/tool-registry.schema.json",
  "title": "Lifecycle Tool Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tools"],
  "properties": {
    "schema_version": { "const": 1 },
    "tools": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/tool" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "toolName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "authentication": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "environment_variables"],
      "properties": {
        "type": { "type": "string", "minLength": 1, "maxLength": 128 },
        "environment_variables": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"
          }
        }
      },
      "not": {
        "anyOf": [
          { "required": ["token"] },
          { "required": ["password"] },
          { "required": ["secret"] },
          { "required": ["api_key"] },
          { "required": ["private_key"] }
        ]
      }
    },
    "allowedMcpTool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "capability", "side_effect", "input_schema"],
      "properties": {
        "name": { "$ref": "#/$defs/toolName" },
        "capability": { "$ref": "#/$defs/identifier" },
        "side_effect": { "const": "read-only" },
        "input_schema": {
          "type": "object",
          "required": ["type"],
          "properties": { "type": { "const": "object" } }
        }
      }
    },
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "server_id",
        "transport",
        "protocol_version",
        "startup_timeout_seconds",
        "timeout_seconds",
        "max_output_bytes",
        "max_pages",
        "max_tools",
        "environment_variables",
        "requires_network",
        "mutation_policy",
        "allowed_tools"
      ],
      "properties": {
        "server_id": { "$ref": "#/$defs/identifier" },
        "transport": { "enum": ["stdio", "streamable_http"] },
        "protocol_version": { "enum": ["2025-06-18", "2025-11-25"] },
        "command": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
        },
        "url": { "type": "string", "format": "uri" },
        "startup_timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 120 },
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 600 },
        "max_output_bytes": {
          "type": "integer",
          "minimum": 4096,
          "maximum": 10485760
        },
        "max_pages": { "type": "integer", "minimum": 1, "maximum": 100 },
        "max_tools": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "environment_variables": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"
          }
        },
        "requires_network": { "type": "boolean" },
        "mutation_policy": { "const": "deny" },
        "allowed_tools": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/allowedMcpTool" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "transport": { "const": "stdio" } } },
          "then": { "required": ["command"] },
          "else": { "required": ["url"] }
        }
      ]
    },
    "tool": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "display_name",
        "provider",
        "kind",
        "capabilities",
        "transport",
        "availability",
        "authentication",
        "side_effects",
        "approval"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "provider": { "$ref": "#/$defs/identifier" },
        "kind": { "type": "string", "minLength": 1, "maxLength": 128 },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "transport": {
          "enum": [
            "native",
            "skill",
            "mcp",
            "cli",
            "http",
            "webhook",
            "http-and-webhook",
            "mcp-or-cli-or-http"
          ]
        },
        "availability": { "enum": ["unknown", "available", "unavailable", "blocked"] },
        "read_scopes": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
        },
        "write_scopes": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
        },
        "authentication": { "$ref": "#/$defs/authentication" },
        "side_effects": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        },
        "approval": { "type": "string", "minLength": 1, "maxLength": 128 },
        "mcp": { "$ref": "#/$defs/mcp" }
      },
      "allOf": [
        {
          "if": { "properties": { "transport": { "const": "mcp" } } },
          "then": { "required": ["mcp"] }
        }
      ]
    }
  }
}
